# DataBridge AI — environment variables.
# Copy to .env and fill in real values. Never commit .env.
# Both services validate these at startup and refuse to start if any are missing or invalid.

# ---------------------------------------------------------------- apps/api (Node)
# development | test | production. In "test", safe placeholder defaults are used for unset vars.
NODE_ENV=development
# Port the public API listens on.
PORT=4000
# MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=mongodb://localhost:27017/databridge
# Redis URL (redis:// or rediss://) — job queue and cache.
REDIS_URL=redis://localhost:6379/0
# JWT signing secrets, min 32 chars each, different from each other. The access secret signs
# access JWTs; the refresh secret keys the HMAC-SHA256 used to store refresh tokens hashed.
# With NODE_ENV=production the api refuses to start if a secret contains "change-me" or the two
# JWT secrets are equal.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
# Base URL of the internal AI service (never exposed publicly).
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Service-Token from api to ai-service (min 16 chars). Same value in both services.
AI_SERVICE_TOKEN=change-me-service-token
# Timeout for one api -> ai-service call (start or cancel a job), in milliseconds.
AI_SERVICE_TIMEOUT_MS=5000
# Browser origin allowed by CORS (the web app URL). Credentials (the refresh cookie) are allowed
# only for this origin.
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy": which proxies may set X-Forwarded-For (used for the client IP in rate
# limiting). Default false = use the socket address. Use 1 when exactly one proxy you control
# (e.g. nginx) sits in front and the api port is NOT reachable directly; "true" trusts any client
# header and lets attackers dodge rate limits. Also accepts "loopback" or a subnet list.
TRUST_PROXY=false
# Rate limit for /api/v1/auth/* per client IP: max requests per window (window in milliseconds).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# File uploads and storage (docs/adr/0009-file-uploads-and-storage.md).
# Where uploaded files are stored: "local" (default; a directory on disk) or "s3" (AWS S3,
# Cloudflare R2, MinIO or any S3-compatible store).
STORAGE_DRIVER=local
# Root directory for STORAGE_DRIVER=local. Relative paths are resolved from the api's working
# directory. Docker compose sets /data/uploads (a named volume shared read-only with ai-service).
UPLOAD_DIR=./data/uploads
# STORAGE_DRIVER=s3 only. Bucket and region are required (R2 uses region "auto").
S3_BUCKET=
S3_REGION=
# Custom endpoint for R2 or MinIO, e.g. https://<account>.r2.cloudflarestorage.com or
# http://localhost:9000. Leave empty for AWS S3.
S3_ENDPOINT=
# true for MinIO (bucket in the path instead of the host name).
S3_FORCE_PATH_STYLE=false
# Access keys. Leave both empty to use the AWS default credential chain (e.g. an instance role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Largest accepted upload in bytes (default 50 MiB). infra/nginx.conf allows 55 MB so the api, not
# nginx, answers with a clear error; raise both together.
MAX_UPLOAD_BYTES=52428800
# Most data rows (header excluded) in one CSV upload. Also read by the ai-service profiler, which
# enforces it for XLSX files (and again for CSV).
MAX_UPLOAD_ROWS=200000
# Zip-bomb guard for XLSX files, read by both the api (preview) and the ai-service (profiler);
# see docs/adr/0011-column-profiling.md. Every entry is really inflated and counted: a workbook
# that unpacks to more than this many bytes (default 200 MiB, min 1 MiB) is refused with
# FILE_TOO_COMPLEX ...
XLSX_MAX_UNCOMPRESSED_BYTES=209715200
# ... and so is one that unpacks to more than this many times its file size (checked once more
# than 10 MiB have come out, so small repetitive workbooks pass; min 10).
XLSX_MAX_COMPRESSION_RATIO=100
# Most sources (uploaded files) in one project.
MAX_SOURCES_PER_PROJECT=10
# Uploads allowed per user per window (window in milliseconds; default 30 per hour).
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000

# Background jobs (docs/adr/0010-background-jobs.md).
# A running job whose worker sent no heartbeat (progress or ctx.heartbeat()) for this many
# seconds is reported as failed with WORKER_LOST the next time it is read.
JOB_STALE_AFTER_SECONDS=300
# Interval of the ": keep-alive" comment on GET /api/v1/jobs/:jobId/events, in milliseconds.
# Each keep-alive also re-reads the job, so a lost Redis message is caught within this time.
JOB_EVENTS_KEEPALIVE_MS=15000

# ---------------------------------------------------------------- Docker compose only
# infra/docker-compose.yml sets container addresses itself (mongo, redis, ai-service) and passes
# the secrets above through. Browser origin of the nginx web container (used as CORS_ORIGIN there).
WEB_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------- apps/ai-service (Python)
# Also reads AI_SERVICE_TOKEN, REDIS_URL and MONGODB_URI from above. Every LLM call goes through
# the gateway (PII masking, cache, retries, cost log): see docs/adr/0006.
# LLM provider: "mock" (default; tests and CI always use mock) or "gemini".
LLM_PROVIDER=mock
# Google Gemini API key. Required only when LLM_PROVIDER=gemini (the service refuses to start
# without it). Free-tier prompts may be used by Google to improve its products: synthetic data only.
GEMINI_API_KEY=
# Gemini model code. Default: Flash Lite, whose free tier allows 15 requests/min and 500/day
# (gemini-3.8-flash: 5/min, 20/day). Models: ai.google.dev/gemini-api/docs/models (checked
# 2026-11-22). Change it here when Google retires or replaces the model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini thinking level: minimal, low, medium or high; empty = the model's default (Lite models
# may not accept a level). For Gemini 3 Flash models use low: their default (medium) made mapping
# calls slow. Thought tokens count as output tokens.
GEMINI_THINKING_LEVEL=
# Cache identical (masked) LLM requests in Redis for this many seconds. 0 turns caching off.
LLM_CACHE_TTL_SECONDS=86400
# Attempts per call for retryable errors (rate limit, timeout, provider unavailable), 1-10.
LLM_MAX_ATTEMPTS=3
# Backoff between attempts: base * multiplier^(attempt-1) seconds, +/-20% jitter, capped at max
# (about 2 s, 5 s, 12.5 s).
LLM_BACKOFF_BASE_SECONDS=2.0
LLM_BACKOFF_MULTIPLIER=2.5
LLM_BACKOFF_MAX_SECONDS=30.0
# A 429's RetryInfo delay (when longer than the backoff) is waited out, up to this many seconds.
LLM_RETRY_AFTER_MAX_SECONDS=60
# Provider attempts per minute, retries included, per process (the api's ai-service and each
# worker process pace separately); 0 = off. Keep it below the key's limit (Flash Lite free: 15).
LLM_MAX_REQUESTS_PER_MINUTE=12
# Hard timeout for one provider attempt, in seconds (0-600; the live evaluation uses 90).
LLM_TIMEOUT_SECONDS=30
# Optional price table, INR per 1M tokens, as JSON. These are ASSUMPTIONS for cost reporting, not
# facts: check Google's pricing page and your exchange rate. Unset = free tier (cost 0, tokens
# still logged; the report says "free tier"). Example for gemini-3.8-flash on the paid tier at
# USD 0.75 / 3.75 per 1M and about INR 88 per USD:
# LLM_PRICES_INR_PER_1M={"gemini-3.8-flash": {"input": 66, "output": 330}}
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Column profiler (ai-worker): the uploads folder written by the api, read-only here. Use the same
# folder as the api's UPLOAD_DIR (an absolute path is safest when running both outside Docker).
# Docker compose mounts the shared volume at /data/uploads. Also reads MAX_UPLOAD_ROWS and the
# XLSX_* limits above.
# UPLOAD_DIR=/absolute/path/to/apps/api/data/uploads

# Background jobs, read by the ai-service and the Celery worker (ai-worker in compose). The worker
# runs with: celery -A app.worker.celery_app:celery_app worker --concurrency=2
# A job still running after the soft limit fails with TIME_LIMIT_EXCEEDED; at the hard limit its
# process is killed. The hard limit must be greater than the soft one.
JOB_SOFT_TIME_LIMIT_SECONDS=900
JOB_HARD_TIME_LIMIT_SECONDS=960
# Attempts per job when a transient error (MongoDB or Redis connection problem) happens, 1-10.
# Errors raised on purpose by a job handler are never retried.
JOB_MAX_ATTEMPTS=3
# Backoff between attempts: base * 2^(retry-1) seconds, capped at max.
JOB_RETRY_BACKOFF_SECONDS=2
JOB_RETRY_BACKOFF_MAX_SECONDS=60

# Column mapping (ai-worker; docs/adr/0012-column-mapping.md). The model is the gateway's
# (LLM_PROVIDER / GEMINI_MODEL). false = deterministic rules only, no LLM call.
MAPPING_LLM_ENABLED=true
# Sampling temperature for the mapping prompt, 0-1. 0 keeps answers repeatable and cacheable.
MAPPING_TEMPERATURE=0
# Most output tokens per mapping call (thinking included), 256-65536.
MAPPING_MAX_OUTPUT_TOKENS=4096
# Columns per mapping call, 1-40. Smaller calls answer faster; larger ones make fewer calls.
MAPPING_MAX_COLUMNS_PER_CALL=40
