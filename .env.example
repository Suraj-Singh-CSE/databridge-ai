# DataBridge AI — environment variables.
# Copy to .env and fill in real values. Never commit .env.
# Both services validate these at startup and refuse to start if any are missing or invalid.

# ---------------------------------------------------------------- apps/api (Node)
# development | test | production. In "test", safe placeholder defaults are used for unset vars.
NODE_ENV=development
# Port the public API listens on (hosting platforms such as Render inject PORT). The ai-service
# also reads PORT (default 8000) when run with `python -m app.supervisor` (its Docker image).
PORT=4000
# MongoDB connection string (mongodb:// or mongodb+srv://).
MONGODB_URI=mongodb://localhost:27017/databridge
# Redis URL (redis:// or rediss://) — job queue and cache.
REDIS_URL=redis://localhost:6379/0
# JWT signing secrets, min 32 chars each, different from each other. The access secret signs
# access JWTs; the refresh secret keys the HMAC-SHA256 used to store refresh tokens hashed.
# With NODE_ENV=production the api refuses to start if a secret contains "change-me" or the two
# JWT secrets are equal.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
# Base URL of the internal AI service (never exposed publicly).
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Service-Token from api to ai-service (min 16 chars). Same value in both services.
AI_SERVICE_TOKEN=change-me-service-token
# Timeout for one api -> ai-service call (start or cancel a job), in milliseconds.
AI_SERVICE_TIMEOUT_MS=5000
# Before starting a job or asking the assistant, wake a sleeping ai-service (free hosting sleeps
# after 15 minutes without traffic) by polling its /health with backoff for up to this many ms.
# If it is still not up, the api answers 503 AI_SERVICE_WAKING ("Starting the AI service ...").
# 0 = never wait. See docs/adr/0026-free-tier-runtime.md.
AI_SERVICE_WAKE_TIMEOUT_MS=90000
# Project assistant (docs/adr/0025-assistant.md), read by the api: timeout of one answer (it
# may wait for the model), questions per user per window (shared by api processes through
# Redis; low because each question is one model request, docs/adr/0028), and turns kept per
# conversation (the oldest are dropped).
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_RATE_LIMIT_MAX=5
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_MAX_TURNS=50
# Browser origin allowed by CORS (the web app URL). Credentials (the refresh cookie) are allowed
# only for this origin.
CORS_ORIGIN=http://localhost:5173
# Express "trust proxy": which proxies may set X-Forwarded-For (used for the client IP in rate
# limiting). Default false = use the socket address. Use 1 when exactly one proxy you control
# (e.g. nginx) sits in front and the api port is NOT reachable directly; "true" trusts any client
# header and lets attackers dodge rate limits. Also accepts "loopback" or a subnet list.
TRUST_PROXY=false
# On Render (one proxy in front of the service) use TRUST_PROXY=1.
# Where the api keeps its rate-limit counters (sign-in, session, assistant): redis = shared by
# every api process (REDIS_URL; this process's memory while Redis is down), memory = this
# process only. See docs/adr/0028-privacy-and-quota-hardening.md.
RATE_LIMIT_STORE=redis
# Sign-in and registration attempts per client IP + email, per window (milliseconds).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Session calls (refresh, me, logout, auth config) per client IP, per window: generous, so normal
# use (several tabs, reloads) never locks anyone out.
SESSION_RATE_LIMIT_MAX=120
SESSION_RATE_LIMIT_WINDOW_MS=900000

# Access control (docs/adr/0027-same-origin-and-access.md).
# Only the account registered (or signed in) with exactly this email becomes admin, once. Empty =
# nobody becomes admin automatically (the api logs a warning at startup).
BOOTSTRAP_ADMIN_EMAIL=
# Who may create an account: open (default), invite (needs one of REGISTRATION_INVITE_CODES) or
# closed. New accounts get the data_engineer role.
REGISTRATION_MODE=open
# Comma-separated invite codes, 8+ characters each, for REGISTRATION_MODE=invite. Never logged.
REGISTRATION_INVITE_CODES=

# Same-origin web app (docs/adr/0027-same-origin-and-access.md). true = the api also serves the
# built web app (SPA fallback for client routes), so the browser and the API share one origin.
# The api image ships the build and sets WEB_DIST_DIR; locally run `npm run build -w apps/web`.
SERVE_WEB=false
WEB_DIST_DIR=../web/dist

# File uploads and storage (docs/adr/0009-file-uploads-and-storage.md, docs/adr/0026).
# Read by BOTH the api and the ai-service (uploads are read and exports written by the worker):
# set the same values in both. Where files are stored: "local" (default; a directory on disk
# shared by the two) or "s3" (Cloudflare R2, MinIO, AWS S3 or any S3-compatible store; needed
# on free hosting, which has no shared or persistent disk).
STORAGE_DRIVER=local
# Root directory for STORAGE_DRIVER=local. Relative paths are resolved from the api's working
# directory. Docker compose sets /data/uploads (a named volume shared read-only with ai-service).
UPLOAD_DIR=./data/uploads
# STORAGE_DRIVER=s3 only. Bucket and region are required (R2 uses region "auto").
S3_BUCKET=
S3_REGION=
# Custom endpoint for R2 or MinIO, e.g. https://<account>.r2.cloudflarestorage.com or
# http://localhost:9000. Leave empty for AWS S3.
S3_ENDPOINT=
# true for MinIO (bucket in the path instead of the host name).
S3_FORCE_PATH_STYLE=false
# Access keys. Leave both empty to use the AWS default credential chain (e.g. an instance role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Largest accepted upload in bytes (default 50 MiB). infra/nginx.conf allows 55 MB so the api, not
# nginx, answers with a clear error; raise both together. The ai-service refuses to read a stored
# file larger than this (FILE_TOO_LARGE).
MAX_UPLOAD_BYTES=52428800
# Most data rows (header excluded) in one CSV upload. Also read by the ai-service profiler, which
# enforces it for XLSX files (and again for CSV).
MAX_UPLOAD_ROWS=200000
# Zip-bomb guard for XLSX files, read by both the api (preview) and the ai-service (profiler);
# see docs/adr/0011-column-profiling.md. Every entry is really inflated and counted: a workbook
# that unpacks to more than this many bytes (default 200 MiB, min 1 MiB) is refused with
# FILE_TOO_COMPLEX ...
XLSX_MAX_UNCOMPRESSED_BYTES=209715200
# ... and so is one that unpacks to more than this many times its file size (checked once more
# than 10 MiB have come out, so small repetitive workbooks pass; min 10).
XLSX_MAX_COMPRESSION_RATIO=100
# Most sources (uploaded files) in one project.
MAX_SOURCES_PER_PROJECT=10
# Uploads allowed per user per window (window in milliseconds; default 30 per hour).
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000

# Background jobs (docs/adr/0010-background-jobs.md).
# A running job whose worker sent no heartbeat (progress or ctx.heartbeat()) for this many
# seconds is reported as failed with WORKER_LOST the next time it is read.
JOB_STALE_AFTER_SECONDS=300
# A queued job that no worker claimed for this many seconds, while no other job is running, is
# reported as failed with QUEUE_LOST (its queue message was lost, e.g. a free Redis restarted).
JOB_QUEUED_STALE_AFTER_SECONDS=600
# Interval of the ": keep-alive" comment on GET /api/v1/jobs/:jobId/events, in milliseconds.
# Each keep-alive also re-reads the job, so a lost Redis message is caught within this time.
JOB_EVENTS_KEEPALIVE_MS=15000

# Data retention (docs/adr/0029-concurrency-and-retention.md), sized for MongoDB Atlas M0
# (512 MB). TTL indexes, built at api startup: finished jobs (by finishedAt; queued and running
# jobs never expire), LLM call logs, and assistant conversations (days since the last message).
JOB_RETENTION_DAYS=30
LLM_CALL_RETENTION_DAYS=30
ASSISTANT_RETENTION_DAYS=30
# Removed by the api's retention sweep: export files and their metadata after this many days,
# quality reports older than this (each project's newest report is always kept), and audit
# entries beyond the newest N per project (a demo-tier cap; raise it on a paid tier).
EXPORT_RETENTION_DAYS=30
QUALITY_RUN_RETENTION_DAYS=90
AUDIT_MAX_ENTRIES_PER_PROJECT=20000
# How often each api process runs the sweep (it also runs once at startup). 0 = never.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# ---------------------------------------------------------------- Docker compose only
# infra/docker-compose.yml sets container addresses itself (mongo, redis, ai-service) and passes
# the secrets above through. Browser origin of the nginx web container (used as CORS_ORIGIN there).
WEB_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------- apps/ai-service (Python)
# Also reads AI_SERVICE_TOKEN, REDIS_URL and MONGODB_URI from above. Every LLM call goes through
# the gateway (PII masking, cache, retries, cost log): see docs/adr/0006.
# LLM provider: "mock" (default; tests and CI always use mock) or "gemini".
LLM_PROVIDER=mock
# Google Gemini API key. Required only when LLM_PROVIDER=gemini (the service refuses to start
# without it). Free-tier prompts may be used by Google to improve its products: synthetic data only.
GEMINI_API_KEY=
# Gemini model code. Default: Flash Lite, whose free tier allows 15 requests/min and 500/day
# (gemini-3.8-flash: 5/min, 20/day). Models: ai.google.dev/gemini-api/docs/models (checked
# 2026-11-22). Change it here when Google retires or replaces the model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini thinking level: minimal, low, medium or high; empty = the model's default (Lite models
# may not accept a level). For Gemini 3 Flash models use low: their default (medium) made mapping
# calls slow. Thought tokens count as output tokens.
GEMINI_THINKING_LEVEL=
# Cache identical (masked) LLM requests in Redis for this many seconds. 0 turns caching off.
LLM_CACHE_TTL_SECONDS=86400
# Attempts per call for retryable errors (rate limit, timeout, provider unavailable), 1-10.
LLM_MAX_ATTEMPTS=3
# Backoff between attempts: base * multiplier^(attempt-1) seconds, +/-20% jitter, capped at max
# (about 2 s, 5 s, 12.5 s).
LLM_BACKOFF_BASE_SECONDS=2.0
LLM_BACKOFF_MULTIPLIER=2.5
LLM_BACKOFF_MAX_SECONDS=30.0
# A 429's RetryInfo delay (when longer than the backoff) is waited out, up to this many seconds.
LLM_RETRY_AFTER_MAX_SECONDS=60
# Provider attempts per minute, retries included, shared by every ai-service and worker process
# through Redis (per process while Redis is down); 0 = off. Keep it below the key's limit
# (Flash Lite free: 15). Not applied to LLM_PROVIDER=mock. docs/adr/0028.
LLM_MAX_REQUESTS_PER_MINUTE=12
# Provider attempts per day per provider+model, shared through Redis; 0 = off. Below the key's
# daily limit (Flash Lite free: 500). When used up, mapping falls back to rules, pair review is
# skipped, the SQL agent uses the reference query, the assistant says the AI is resting until
# tomorrow and knowledge search uses keywords. Not applied to LLM_PROVIDER=mock.
LLM_DAILY_REQUEST_BUDGET=400
# The same per project, so one project cannot use the whole day; 0 = off (local default).
LLM_PROJECT_DAILY_REQUEST_BUDGET=0
# When the daily counters start again: midnight in this IANA time zone (Gemini's requests per
# day reset at midnight Pacific time).
LLM_DAILY_BUDGET_RESET_TIMEZONE=America/Los_Angeles
# redis = counters shared by every process (falls back to memory while Redis is down);
# memory = this process only.
LLM_QUOTA_STORE=redis
# Hard timeout for one provider attempt, in seconds (0-600; the live evaluation uses 90).
LLM_TIMEOUT_SECONDS=30
# Optional price table, INR per 1M tokens, as JSON. These are ASSUMPTIONS for cost reporting, not
# facts: check Google's pricing page and your exchange rate. Unset = free tier (cost 0, tokens
# still logged; the report says "free tier"). Example for gemini-3.8-flash on the paid tier at
# USD 0.75 / 3.75 per 1M and about INR 88 per USD:
# LLM_PRICES_INR_PER_1M={"gemini-3.8-flash": {"input": 66, "output": 330}}
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Column profiler and exports (ai-worker) read STORAGE_DRIVER, the S3_* variables and
# MAX_UPLOAD_BYTES above. With STORAGE_DRIVER=local, UPLOAD_DIR is the api's storage folder:
# uploads are only read; the export job writes under projects/<id>/exports/ there. Use the same
# folder as the api's UPLOAD_DIR (an absolute path is safest when running both outside Docker).
# Docker compose mounts the shared volume at /data/uploads. Also reads MAX_UPLOAD_ROWS and the
# XLSX_* limits above.
# UPLOAD_DIR=/absolute/path/to/apps/api/data/uploads
# With STORAGE_DRIVER=s3, uploads are downloaded to (and exports written in) a temporary file
# here first, removed after use; empty = the system temporary folder.
STORAGE_TEMP_DIR=

# Process runtime of the ai-service image (`python -m app.supervisor`; docs/adr/0026).
# true = also run the Celery worker in this container (free hosting has no background workers);
# false = a separate worker process runs the jobs (ai-worker in docker compose).
RUN_WORKER=false
# Celery pool: prefork (child processes; job time limits enforced, an out-of-memory kill only
# ends the child) or solo (least memory, but the time limits are NOT enforced).
WORKER_POOL=prefork
# Jobs at the same time (prefork children). The free demo uses 1.
WORKER_CONCURRENCY=2
# Replace a prefork child that uses more than this many MB after a job; 0 = never.
WORKER_MAX_MEMORY_PER_CHILD_MB=0
# Seconds to wait after SIGTERM (uvicorn finishes requests, Celery its job) before killing.
SHUTDOWN_GRACE_SECONDS=25
# Keep-alive while a job runs: the worker requests this public URL every interval, because a
# free web service sleeps after 15 minutes without INBOUND HTTP. Empty = RENDER_EXTERNAL_URL
# (set by Render) + /internal/v1/health, or off when that is not set either.
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=300

# Background jobs, read by the ai-service and the Celery worker (ai-worker in compose). The worker
# runs with: celery -A app.worker.celery_app:celery_app worker --concurrency=2
# A job still running after the soft limit fails with TIME_LIMIT_EXCEEDED; at the hard limit its
# process is killed. The hard limit must be greater than the soft one.
JOB_SOFT_TIME_LIMIT_SECONDS=900
JOB_HARD_TIME_LIMIT_SECONDS=960
# Attempts per job when a transient error (MongoDB or Redis connection problem) happens, 1-10.
# Errors raised on purpose by a job handler are never retried.
JOB_MAX_ATTEMPTS=3
# Backoff between attempts: base * 2^(retry-1) seconds, capped at max.
JOB_RETRY_BACKOFF_SECONDS=2
JOB_RETRY_BACKOFF_MAX_SECONDS=60

# Column mapping (ai-worker; docs/adr/0012-column-mapping.md). The model is the gateway's
# (LLM_PROVIDER / GEMINI_MODEL). false = deterministic rules only, no LLM call.
MAPPING_LLM_ENABLED=true
# Sampling temperature for the mapping prompt, 0-1. 0 keeps answers repeatable and cacheable.
MAPPING_TEMPERATURE=0
# Most output tokens per mapping call (thinking included), 256-65536.
MAPPING_MAX_OUTPUT_TOKENS=4096
# Columns per mapping call, 1-40. Smaller calls answer faster; larger ones make fewer calls.
MAPPING_MAX_COLUMNS_PER_CALL=40

# Candidate pairs (ai-worker, docs/adr/0015-blocking.md): a blocking key shared by more records
# than this (a shared office phone, a very common name in one city) is skipped and counted
# instead of paired. 2-5000.
BLOCKING_MAX_BLOCK_SIZE=200
# Memory caps (docs/adr/0026): most staged records the candidates job reads into memory
# (MATCHING_TOO_LARGE above it) and most candidate pairs kept (TOO_MANY_PAIRS; scoring and
# clustering load every pair).
MATCHING_MAX_RECORDS=1000000
MATCHING_MAX_PAIRS=5000000

# Pair scoring (ai-worker, docs/adr/0016-pair-scoring.md). A pair scoring at or above the match
# threshold is "match", at or above the maybe threshold "maybe" (for review), else "non_match".
# Both between 0 and 1, maybe lower than match.
SCORING_MATCH_THRESHOLD=0.90
SCORING_MAYBE_THRESHOLD=0.50
# em: estimate the field weights from the project's own candidate pairs (unsupervised), falling
# back to the hand-set defaults when that fails; defaults: always the hand-set weights.
SCORING_MODEL=em

# AI review of maybe pairs (ai-worker, docs/adr/0017-ai-pair-review.md). The model sees derived
# evidence only (levels, similarities, name shapes), never a personal value, and only suggests.
# false = no LLM call: maybe pairs are saved with aiStatus "unavailable".
PAIR_REVIEW_LLM_ENABLED=true
# Maybe pairs per LLM call, 1-25.
PAIR_REVIEW_PAIRS_PER_CALL=10
# An AI "same"/"different" at or above this confidence sets suggestedBand to match/non_match;
# below it the pair stays maybe. Above 0, at most 1. The band itself never changes.
PAIR_REVIEW_CONFIDENCE_THRESHOLD=0.8
# 0 keeps answers repeatable (and cacheable).
PAIR_REVIEW_TEMPERATURE=0
PAIR_REVIEW_MAX_OUTPUT_TOKENS=4096

# Clusters and golden records (ai-worker, docs/adr/0018-clusters-and-golden-records.md). Both are
# proposals for a person to approve. true = maybe pairs the AI suggested as "match" also link
# records (the clusters they join are marked ai_suggested); false = only "match" pairs link.
CLUSTERING_INCLUDE_AI_SUGGESTED=true
# Clusters with more records than this are flagged needs_review (never split). 2-1000.
CLUSTERING_MAX_CLUSTER_SIZE=6
# Source trust order for golden-record ties, most trusted first, comma-separated; matched
# against a source's system name or a word of its name. Unlisted sources come after, in upload
# order.
SURVIVORSHIP_SOURCE_TRUST=crm,billing,support

# Export of golden records to CSV / Excel (docs/adr/0020-export.md), read by the ai-worker.
# Most rows in one export file (1 - 1000000; Excel holds at most 1,048,575 rows per sheet).
# Exports are stored like uploads (STORAGE_DRIVER).
EXPORT_MAX_ROWS=200000

# SQL agent (docs/adr/0021-sql-agent.md), read by the ai-worker. The agent drafts the query that
# builds the final customers table; it is validated, run in an in-memory DuckDB sandbox and
# tested before a person can approve it. The prompt holds schema and statistics only.
# false = no LLM call: every draft uses the hand-written reference query (method "reference").
SQL_AGENT_LLM_ENABLED=true
# Repairs after a draft that fails validation or a test (0-5; each one is an LLM call).
SQL_AGENT_MAX_REPAIRS=2
SQL_AGENT_TEMPERATURE=0
SQL_AGENT_MAX_OUTPUT_TOKENS=4096
# Sandbox limits: seconds per statement (the query is interrupted after it), memory and threads.
SQL_STATEMENT_TIMEOUT_SECONDS=20
SQL_MEMORY_LIMIT_MB=512
SQL_THREADS=2
# Most staged records loaded into the sandbox (the job fails with SQL_TOO_LARGE above it).
SQL_MAX_RECORDS=200000

# Data quality checks (docs/adr/0022-data-quality.md), read by the ai-worker. Defaults for every
# project; a project can override thresholds (PUT /api/v1/projects/:projectId/quality/rules).
# The api reads the three threshold variables too, to show "Default: …" in the thresholds
# dialog: set them to the same values on both services.
# Clusters or the approved SQL's last run older than this: the freshness rules warn, then fail.
QUALITY_FRESHNESS_WARN_HOURS=24
QUALITY_FRESHNESS_FAIL_HOURS=168
# Warn when the final table's row count changed by more than this since the previous check.
QUALITY_ROW_CHANGE_WARN_PERCENT=20
# Quality reports kept per project (older ones are deleted after each check).
QUALITY_HISTORY_LIMIT=50

# Knowledge index for the project assistant (docs/adr/0024-knowledge-index.md), read by the
# ai-worker (indexing) and the ai-service (search). Chunks hold no record values; embeddings go
# through the LLM gateway (task "embedding") and are reused for unchanged chunks.
# Embedding model of the Gemini provider (LLM_PROVIDER=gemini); the mock provider hashes words.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Vector length asked of the embedding model (64-3072).
EMBEDDING_DIMENSIONS=768
# Texts per embedding request (1-100); each request is paced like a chat call.
EMBEDDING_BATCH_SIZE=32
# false = keyword search only (BM25); no chunk or query is sent for embedding.
KNOWLEDGE_EMBEDDINGS_ENABLED=true
# Quality runs indexed per project (newest first; the latest gets one chunk per rule).
KNOWLEDGE_QUALITY_RUNS=5
# Folder holding README.md and docs/adr/*.md to index. Empty = the repository the code runs
# from; the Docker image sets /app/knowledge-docs.
KNOWLEDGE_DOCS_DIR=

# Project assistant answers (docs/adr/0025-assistant.md), read by the ai-service. Answers come
# only from retrieved chunks, through the LLM gateway (task "assistant").
# Chunks retrieved and numbered in the prompt per question (1-20).
ASSISTANT_TOP_K=8
# Refuse without a model call when no retrieved chunk holds this share of the question's words.
ASSISTANT_MIN_TERM_OVERLAP=0.6
# Earlier turns of the conversation given to the model (0-10).
ASSISTANT_HISTORY_TURNS=4
ASSISTANT_TEMPERATURE=0
ASSISTANT_MAX_OUTPUT_TOKENS=1024
# Seconds a project's staged personal values (the question guard) are kept in memory.
ASSISTANT_GUARD_CACHE_SECONDS=60
