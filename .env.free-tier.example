# DataBridge AI — "free demo" profile for free hosting (docs/adr/0026-free-tier-runtime.md).
# Render free web services (512 MB RAM, no disk, no background workers, sleep after 15 min),
# Render Key Value free (Redis), MongoDB Atlas M0, Cloudflare R2 and the Gemini free tier.
# render.yaml (the Render Blueprint, docs/deploy-free-tier.md) sets these values; keep the two in step.
# Every variable is explained in .env.example; this file holds only the values that differ from
# the defaults, or that free hosting needs. Set them in each service's environment (never commit
# real values). Replace every CHANGE-ME and example host name.
#
# Not supported on free hosting: private networking (the ai-service is a public web service,
# protected by AI_SERVICE_TOKEN), a persistent disk (files live in R2), a background worker
# (the worker runs inside the ai-service container), jobs that survive a restart (they end as
# WORKER_LOST / QUEUE_LOST and are run again), and large projects (the limits below).

# ================================================================= both services
MONGODB_URI=mongodb+srv://databridge:CHANGE-ME@cluster0.example.mongodb.net/databridge
# The Key Value internal URL (render.yaml links it; free web services can use it in the same region).
REDIS_URL=redis://red-example:6379
AI_SERVICE_TOKEN=CHANGE-ME-service-token-at-least-48-random-characters
# Object storage: a private Cloudflare R2 bucket and a token scoped to it (Object Read & Write).
STORAGE_DRIVER=s3
S3_BUCKET=databridge-uploads
S3_REGION=auto
S3_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=CHANGE-ME
S3_SECRET_ACCESS_KEY=CHANGE-ME
# Demo limits sized for 512 MB: 4 sources of at most 20,000 rows and 10 MB each.
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=20000
MAX_SOURCES_PER_PROJECT=4
XLSX_MAX_UNCOMPRESSED_BYTES=52428800
LOG_LEVEL=INFO
# Production mode: the api sets Secure cookies and HSTS; the ai-service hides its API docs and
# demo routes (docs/adr/0027-same-origin-and-access.md).
ENV=production

# ================================================================= api (web service)
NODE_ENV=production
# PORT is set by Render.
JWT_ACCESS_SECRET=CHANGE-ME-access-secret-48-random-characters
JWT_REFRESH_SECRET=CHANGE-ME-refresh-secret-48-random-characters
AI_SERVICE_URL=https://databridge-ai.onrender.com
# A warm service answers in milliseconds; a sleeping one is woken first (up to 90 s).
AI_SERVICE_TIMEOUT_MS=10000
AI_SERVICE_WAKE_TIMEOUT_MS=90000
# Gemini free tier answers can be paced (12 requests per minute).
ASSISTANT_TIMEOUT_MS=60000
# One origin for the web app and the API (docs/adr/0027-same-origin-and-access.md): the api
# serves the built web app (the image ships it in WEB_DIST_DIR), so the SameSite=Strict refresh
# cookie is sent. There is no separate web service. The refresh cookie is HttpOnly, Secure
# (NODE_ENV=production), SameSite=Strict and Path=/api/v1/auth; nothing to configure.
SERVE_WEB=true
WEB_DIST_DIR=/app/apps/web/dist
# The api's own public URL (same origin, so CORS is not used by the app itself).
CORS_ORIGIN=https://databridge-api.onrender.com
# Render puts exactly one proxy in front of the service: trust one X-Forwarded-For hop, so
# rate limits see the real client IP and a client cannot spoof it ("true" would trust any).
TRUST_PROXY=1
# Who becomes admin: only the account registered (or signed in) with exactly this email.
# Register it yourself before you share the URL.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# open | invite | closed. Invite: new accounts need one of the codes below (comma-separated,
# 8+ characters each; share them privately). Closed: nobody can register.
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODES=CHANGE-ME
JOB_STALE_AFTER_SECONDS=300
JOB_QUEUED_STALE_AFTER_SECONDS=600

# Data retention (docs/adr/0029-concurrency-and-retention.md), sized for MongoDB Atlas M0
# (512 MB). TTL indexes, built at api startup: finished jobs (by finishedAt; queued and running
# jobs never expire), LLM call logs, and assistant conversations (days since the last message).
JOB_RETENTION_DAYS=30
LLM_CALL_RETENTION_DAYS=30
ASSISTANT_RETENTION_DAYS=30
# Removed by the api's retention sweep: export files and their metadata after this many days,
# quality reports older than this (each project's newest report is always kept), and audit
# entries beyond the newest N per project (a demo-tier cap; raise it on a paid tier).
EXPORT_RETENTION_DAYS=30
QUALITY_RUN_RETENTION_DAYS=90
AUDIT_MAX_ENTRIES_PER_PROJECT=20000
# How often each api process runs the sweep (it also runs once at startup). 0 = never.
RETENTION_SWEEP_INTERVAL_MINUTES=60
# Rate-limit counters in the shared Key Value (memory while it is down), and few assistant
# questions per user: each one is a model request against the daily budget (ADR 0028).
RATE_LIMIT_STORE=redis
ASSISTANT_RATE_LIMIT_MAX=5

# ================================================================= ai-service (web service)
# PORT is set by Render; uvicorn binds it. The Celery worker runs beside it, one job at a time.
RUN_WORKER=true
WORKER_POOL=prefork
WORKER_CONCURRENCY=1
WORKER_MAX_MEMORY_PER_CHILD_MB=300
# Keep-alive while a job runs. Empty = RENDER_EXTERNAL_URL (set by Render) + /internal/v1/health.
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=300
# Shorter than Render's restart patience; a job cut off by a restart ends as WORKER_LOST.
JOB_SOFT_TIME_LIMIT_SECONDS=600
JOB_HARD_TIME_LIMIT_SECONDS=660
# LLM: Gemini free tier (synthetic data only: free-tier prompts may be used by Google).
LLM_PROVIDER=gemini
GEMINI_API_KEY=CHANGE-ME
# Shared by the web process and the worker through Key Value (docs/adr/0028): 12 per minute
# (the key allows 15) and 400 per day (the key allows 500; the day starts again at midnight
# Pacific time), at most 200 of them for any one project.
LLM_MAX_REQUESTS_PER_MINUTE=12
LLM_DAILY_REQUEST_BUDGET=400
LLM_PROJECT_DAILY_REQUEST_BUDGET=200
LLM_DAILY_BUDGET_RESET_TIMEZONE=America/Los_Angeles
LLM_QUOTA_STORE=redis
# Free Key Value has little memory and may be flushed: cache LLM answers for 1 hour only.
LLM_CACHE_TTL_SECONDS=3600
# In-memory caps for 512 MB (4 sources x 20,000 rows = 80,000 records).
BLOCKING_MAX_BLOCK_SIZE=100
MATCHING_MAX_RECORDS=80000
MATCHING_MAX_PAIRS=500000
SQL_MEMORY_LIMIT_MB=128
SQL_THREADS=1
SQL_MAX_RECORDS=80000
EXPORT_MAX_ROWS=80000
EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_QUALITY_RUNS=3
QUALITY_HISTORY_LIMIT=20
